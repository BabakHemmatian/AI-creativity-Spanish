# ============================================================================
# Variables del servidor (server/index.js, server/socket/*, server/service/*)
# ============================================================================

# Puerto en el que escucha el backend de Express + Socket.io.
PORT=8080

# Cadena de conexión a MongoDB. Para desarrollo local en este equipo,
# normalmente: mongodb://127.0.0.1:27017/co-creatividad
MONGO_URI=mongodb://127.0.0.1:27017/co-creatividad

# ============================================================================
# OpenAI (server/service/openAI.js)
# ============================================================================

# Clave de API de OpenAI (obligatoria; la app no arranca sin ella).
OPENAI_API_KEY=sk-...

# Modelo a usar. Cambia a uno disponible para tu cuenta si "gpt-5" aún no lo está.
OPENAI_MODEL=gpt-5

# (Opcional) Sobrescribe el prompt por defecto del agente de IA. Si lo dejas
# vacío, se usa el DEFAULT_INSTRUCTIONS en español de server/service/openAI.js.
# Ejemplo:
# AI_INS="Trabajarás con el usuario para proponer la mayor cantidad de usos alternativos originales..."
AI_INS=

# ============================================================================
# Tarea de usos alternativos (AUT) — objetos presentados a los participantes
# ============================================================================

# Lista de objetos separados por coma. Se elige uno al azar por ronda.
# Estos coinciden con las claves de server/config/constResponse.js para que
# la condición no interactiva (CON) tenga respuestas normadas en español.
ITEMS=un libro o libros (usados para leer),un tenedor o tenedores (usados para comer),una lata de conserva o latas (usadas para guardar perecederos)

# (Opcional) Forzar siempre el mismo objeto. Si está definido, sobrescribe ITEMS.
# ITEM=un libro o libros (usados para leer)

# Cantidad de objetos por sesión (no es necesario cambiarlo normalmente).
ITEM_LEN=1

# ============================================================================
# Identidad y emparejamiento del agente de IA
# ============================================================================

# UID que el servidor usa para representar al socio de IA en MongoDB.
# Puede ser cualquier cadena estable distinta de los UID de los usuarios reales.
AI_UID=ai-partner-bot

# Duración máxima de toda la sesión del usuario (segundos). 3600 = 1 hora.
SESSION_TIME=3600

# Condición de emparejamiento:
#   ALL → ronda HUM + ronda CON + ronda GPT (orden aleatorio)
#   HUM → solo humano-humano
#   CON → solo no interactiva
#   GPT → solo humano-IA
MATCH_CONDITION=ALL

# Mensaje que se envía a la IA cuando el usuario no responde por mucho tiempo.
NON_REPLY_PROMPT=¿Podrías dar más detalles?

# Cadencia base (segundos) para que la IA responda en GPT/CON, y su variación.
WAIT_TIME=5
WAIT_TIME_DIFF=2

# ============================================================================
# Variables compartidas con el frontend (también deben estar en frontend/.env)
# ============================================================================

# Duración de cada ronda en segundos. 240 = 4 minutos.
REACT_APP_SESSION_TIME=240

# ============================================================================
# Firebase Admin (server/config/firebase-config.js)
# ============================================================================

# Las credenciales del Admin SDK NO se cargan desde aquí; se leen del archivo
# serviceAccountKey.json en la raíz del proyecto (porque firebase-config.js
# lo abre con la ruta relativa "./serviceAccountKey.json" y npm start corre
# desde la raíz). Descárgalo desde la consola de Firebase (Configuración
# del proyecto → Cuentas de servicio → Generar nueva clave privada) y
# guárdalo como Spa_App_Latest/serviceAccountKey.json. NUNCA lo subas
# al repositorio.
