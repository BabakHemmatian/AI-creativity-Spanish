# ============================================================================
# URL del backend
# ============================================================================
# Apunta al puerto donde corre el servidor (PORT en el .env del backend).
REACT_APP_URL=http://localhost:8080

# ============================================================================
# Firebase Web SDK (frontend/src/config/firebase.js)
# ============================================================================
# Crea (o reutiliza) un proyecto de Firebase y habilita Authentication →
# Email/Password. Copia los valores desde Configuración del proyecto →
# General → Tus apps → SDK config.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ============================================================================
# Apariencia del avatar
# ============================================================================
# "human" → avataaars (rostros), "bot" → bottts (robots).
# Dejar vacío preserva el seed original que generó cada usuario.
REACT_APP_AVATAR_OPTION=human

# ============================================================================
# Lógica del experimento (debe coincidir con el backend)
# ============================================================================
# ALL = HUM + CON + GPT en orden aleatorio. Otras opciones: HUM, CON, GPT.
REACT_APP_MATCH_CONDITION=ALL

# Duración de cada ronda en segundos. Debe coincidir con el backend.
REACT_APP_SESSION_TIME=240
